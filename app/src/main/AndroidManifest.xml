<?xml version="1.0" encoding="utf-8"?>
<!--
  EX2 Widgets ставится как обычное пользовательское приложение: системной
  подписи ГУ здесь нет, поэтому заявлены только те разрешения, которые
  выдаются без неё. Наложение работает по SYSTEM_ALERT_WINDOW, виджеты —
  через стандартный AppWidgetHost сторонних лончеров.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="29" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
        Доступ к журналу использования: только он честно говорит, какой экран
        сейчас открыт. Выдаётся не установкой, а вручную — экраном «Использование»
        или appops (им так же выдаётся и наложение).
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_MILEAGE" />
    <uses-permission android:name="android.car.permission.CAR_HVAC" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EX2Widgets">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".widgets.WidgetUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".widgets.OverlayWidgetService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widgets.HubClimateWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_hub_climate">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_hub_climate" />
        </receiver>

        <receiver
            android:name=".widgets.HubDriveWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_hub_drive">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_hub_drive" />
        </receiver>

        <receiver
            android:name=".widgets.HubRegenWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_hub_regen">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_hub_regen" />
        </receiver>

        <receiver
            android:name=".widgets.HubOutsideTempWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_hub_outside_temp">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_hub_outside_temp" />
        </receiver>

        <receiver
            android:name=".widgets.HubWindowsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_hub_windows">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_hub_windows" />
        </receiver>

        <receiver
            android:name=".widgets.HubFrunkWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_hub_frunk">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_hub_frunk" />
        </receiver>
    </application>
</manifest>

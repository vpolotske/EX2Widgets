<?xml version="1.0" encoding="utf-8"?>
<!--
  Открытие переднего багажника: состояние берётся из датчика капота, команда
  уходит цепочкой кандидатов. Поле состояния меняет подпись, пока автомобиль
  не подтвердил открытие чтением.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bg_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hub_card_100"
    android:paddingHorizontal="21.1dp"
    android:paddingVertical="18.3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/hub_frunk_title"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hub_hood"
                android:tint="@color/hub_icon" />

            <Space
                android:layout_width="11.2dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.114"
                android:maxLines="1"
                android:text="@string/hub_frunk_title"
                android:textAllCaps="true"
                android:textColor="@color/hub_label"
                android:textSize="15.5sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/frunk_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hub_dash"
                android:textColor="@color/hub_value"
                android:textSize="22.5sp" />

            <FrameLayout
                android:id="@+id/frunk_open"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/hub_control"
                android:minWidth="126dp"
                android:paddingHorizontal="16.9dp">

                <TextView
                    android:id="@+id/frunk_open_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:maxLines="1"
                    android:text="@string/hub_frunk_open"
                    android:textColor="@color/hub_control_text"
                    android:textSize="19.7sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

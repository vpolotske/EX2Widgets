<?xml version="1.0" encoding="utf-8"?>
<!--
  Отдельная карточка «Рекуперация» один-в-один как в EX2 HUB
  (HomeScreen.SegmentCard): 507×186 — вторая половина прежнего ряда 1034×186.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bg_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hub_panel_100"
    android:orientation="vertical"
    android:paddingHorizontal="19.7dp"
    android:paddingTop="21.1dp"
    android:paddingBottom="16.9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28.1dp"
            android:layout_height="28.1dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hub_bolt"
            android:tint="@color/hub_icon" />

        <Space
            android:layout_width="11.2dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.114"
            android:maxLines="1"
            android:text="@string/hub_regen_title"
            android:textAllCaps="true"
            android:textColor="@color/hub_icon"
            android:textSize="19.7sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="87.1dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/regen_low"
            android:layout_width="0dp"
            android:layout_height="87.1dp"
            android:layout_weight="1"
            android:background="@drawable/hub_control"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/regen_low_icon"
                android:layout_width="39.4dp"
                android:layout_height="39.4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hub_regen_low"
                android:tint="@color/hub_icon" />

            <Space
                android:layout_width="1dp"
                android:layout_height="7.03dp" />

            <TextView
                android:id="@+id/regen_low_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/hub_regen_low"
                android:textColor="@color/hub_control_text"
                android:textSize="22.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/regen_mid"
            android:layout_width="0dp"
            android:layout_height="87.1dp"
            android:layout_marginStart="8.4dp"
            android:layout_weight="1"
            android:background="@drawable/hub_control"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/regen_mid_icon"
                android:layout_width="39.4dp"
                android:layout_height="39.4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hub_regen_mid"
                android:tint="@color/hub_icon" />

            <Space
                android:layout_width="1dp"
                android:layout_height="7.03dp" />

            <TextView
                android:id="@+id/regen_mid_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/hub_regen_mid"
                android:textColor="@color/hub_control_text"
                android:textSize="22.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/regen_high"
            android:layout_width="0dp"
            android:layout_height="87.1dp"
            android:layout_marginStart="8.4dp"
            android:layout_weight="1"
            android:background="@drawable/hub_control"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/regen_high_icon"
                android:layout_width="39.4dp"
                android:layout_height="39.4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hub_regen_high"
                android:tint="@color/hub_icon" />

            <Space
                android:layout_width="1dp"
                android:layout_height="7.03dp" />

            <TextView
                android:id="@+id/regen_high_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/hub_regen_high"
                android:textColor="@color/hub_control_text"
                android:textSize="22.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
